{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "app-license-api",
  "main": "src/index.js",
  "compatibility_date": "2026-09-02",

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "app-license-prod",
      "database_id": "d5698c7f-c382-4b7b-9ef9-a4c45a8ea8c4"
    }
  ],

  "r2_buckets": [
    {
      "binding": "BACKUPS",
      "bucket_name": "homika-cloud-prod"
    }
  ]
}
